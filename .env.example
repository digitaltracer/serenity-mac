# Copy this file to .env and fill in values for dev work.
# The DotEnv loader in SerenityMacApp reads .env at startup and populates
# ProcessInfo.processInfo.environment for any key not already set by the shell.
# A shipped .app bundle launched from Finder does not load .env — bake
# non-secret values into Info.plist via xcconfig for production builds.

# --- Google Calendar ---
# Native Google Sign-In client IDs are build-time app configuration, not
# runtime secrets. Set GOOGLE_CLIENT_ID and GOOGLE_REVERSED_CLIENT_ID in
# Xcode build settings or an xcconfig used by SerenityMac/SerenityIOS.

# --- Serenity cloud backend ---
# Required to connect to Serenity's hosted backend profile.
SERENITY_CLOUD_BASE_URL=
SERENITY_CLOUD_ACCESS_TOKEN=

# --- App OAuth (user sign-in) ---
# Required when the active backend profile uses remote authentication.
SERENITY_OAUTH_BASE_URL=
SERENITY_OAUTH_CLIENT_ID=
SERENITY_OAUTH_REDIRECT_URI=

# --- External Postgres backend ---
# Only needed when the backend profile is set to "external Postgres".
POSTGRES_HOST=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
